{
  "name": "leads-backend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env --import tsx/esm src/index.ts",
    "build": "esbuild src/vercel.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=api/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.33",
    "@ai-sdk/openai-compatible": "^3.0.18",
    "@ai-sdk/provider": "^4.0.4",
    "@ai-sdk/provider-utils": "^5.0.16",
    "@hono/node-server": "^2.0.12",
    "@libsql/client": "^0.17.4",
    "@node-rs/argon2": "^2.0.2",
    "ai": "^7.0.44",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.7",
    "nodemailer": "^9.0.5",
    "tsx": "^4.23.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.8.3"
  }
}
